# Copy to .env and fill in, or just export CLINE_API_KEY in your shell.
#
# Every value here is OPTIONAL. With no key at all the swarm still runs and
# triage falls back to a deterministic heuristic (labelled "heuristic" in the
# report), so nothing on stage depends on the network.

# Cline AI API (OpenAI-compatible endpoint at api.cline.bot)
CLINE_API_KEY=sk_2507c67ed7df0bd23cd9db28cb82a1c9daf9794be1a5b25c440c3865688e7291
CLINE_BASE_URL=https://api.cline.bot/api/v1
CLINE_MODEL=xiaomi/mimo-v2.6-flash

# Optional: Direct Anthropic API (if not using Cline)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Where bug reports, repro files, replay GIFs and run summaries are written.
# Defaults to <repo>/artifacts
GAMEQA_ARTIFACTS=./artifacts